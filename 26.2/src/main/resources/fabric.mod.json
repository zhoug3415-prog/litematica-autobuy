{
  "schemaVersion": 1,
  "id": "litematica-autobuy",
  "version": "${version}",
  "name": "Litematica AutoBuy",
  "description": "Client-side material deficit scanner that sends /buy commands for the selected Litematica placement (Minecraft 26.2).",
  "authors": [
    "zhoug3415-prog"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.autobuy.litematica.AutoBuyClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">=26.2 <=26.2",
    "java": ">=25",
    "fabric-api": ">=0.161.0",
    "litematica": ">=0.28.8",
    "malilib": ">=0.29.6"
  },
  "recommends": {
    "litematica-printer": "*"
  }
}
