{
  "schemaVersion": 1,
  "id": "litematica-autobuy",
  "version": "${version}",
  "name": "Litematica AutoBuy",
  "description": "Client-side material deficit scanner that sends /buy commands for the selected Litematica placement.",
  "authors": [
    "zhoug3415-prog"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.autobuy.litematica.AutoBuyClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">=26.3 <=26.3",
    "java": ">=25",
    "fabric-api": ">=0.160.7",
    "litematica": ">=0.29.1",
    "malilib": ">=0.30.2",
    "cloth-config": ">=26.3.159"
  },
  "recommends": {
    "litematica-printer": "*"
  }
}
